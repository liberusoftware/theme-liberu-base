<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!-- The Boundary suites are what this package ships, so they run here too:
         tests/Pest.php stands each one inside a throwaway fixture package of the
         kind it is written for, which is how a consumer runs it. Excluding them
         left the one thing this package distributes untested by its own CI. -->
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Boundary">
            <directory suffix="Test.php">tests/Boundary</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
